|       diff --git a/pkg/processor/transform.go b/pkg/processor/transform.go                         |
|       --- a/pkg/processor/transform.go                                                             |
|       +++ b/pkg/processor/transform.go                                                             |
|       @@ -88,30 +88,35 @@                                                                          |
|  88   func (p *Processor) Transform(input       │  88   func (p *Processor) Transform(input        |
|       []Record) ([]Record, error) {             │       []Record) ([]Record, error) {              |
|  89   results := make([]Record, 0, len(input))  │  89   results := make([]Record, 0, len(input))   |
|  90 - for _, rec := range input {               │  90 + errCh := make(chan error, len(input))      |
|  91 - if rec.IsEmpty() {                        │  91 + resultCh := make(chan Record, len(input))  |
|  92 - continue                                  │  92 +                                            |
|  93 - }                                         │  93 + for _, rec := range input {                |
|  94 - transformed, err := p.applyRules(rec)     │  94 + go func(r Record) {                        |
|  95 - if err != nil {                           │  95 + if r.IsEmpty() {                           |
|  96 - p.logger.Warn("skipping record", "id",    │  96 + return                                     |
|       rec.ID, "error", err)                     │                                                  |
|  97 - p.metrics.IncrementSkipped()              │  97 + }                                          |
|  98 - continue                                  │  98 + transformed, err := p.applyRules(r)        |
|  99 - }                                         │  99 + if err != nil {                            |
| 100 - if transformed.Score < p.threshold {      │ 100 + p.logger.Warn("skipping record", "id",     |
|                                                 │       r.ID, "error", err)                        |
| 101 - p.metrics.IncrementFiltered()             │ 101 + p.metrics.IncrementSkipped()               |
| 102 - continue                                  │ 102 + errCh <- err                               |
| 103 - }                                         │ 103 + return                                     |
| 104 - results = append(results, transformed)    │ 104 + }                                          |
| 105 - p.metrics.IncrementProcessed()            │ 105 + if transformed.Score < p.threshold {       |
| 106 - }                                         │ 106 + p.metrics.IncrementFiltered()              |
|                                                 │ 107 + return                                     |
|                                                 │ 108 + }                                          |
|                                                 │ 109 + resultCh <- transformed                    |
|                                                 │ 110 + p.metrics.IncrementProcessed()             |
|                                                 │ 111 + }(rec)                                     |
|                                                 │ 112 + }                                          |
| 107                                             │ 113                                              |
| 108 - sort.Slice(results, func(i, j int) bool { │ 114 + close(resultCh)                            |
| 109 - return results[i].Score > results[j].Score│ 115 + for r := range resultCh {                  |
| 110 - })                                        │ 116 + results = append(results, r)               |
|                                                 │ 117 + }                                          |
| 111                                             │ 118                                              |
| 112   p.logger.Info("transform complete",       │ 119   p.logger.Info("transform complete",        |
|       "total", len(results))                    │       "total", len(results))                     |
