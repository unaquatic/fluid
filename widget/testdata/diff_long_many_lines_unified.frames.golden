=== text ===
|      diff --git a/pkg/processor/transform.go b/pkg/processor/        |
|      transform.go                                                    |
|      --- a/pkg/processor/transform.go                                |
|      +++ b/pkg/processor/transform.go                                |
|      @@ -88,30 +88,35 @@                                             |
| 88   func (p *Processor) Transform(input []Record) ([]Record, error) |
|      {                                                               |
| 89       results := make([]Record, 0, len(input))                    |
| 90 -     for _, rec := range input {                                 |
| 91 -         if rec.IsEmpty() {                                      |
| 92 -             continue                                            |
| 93 -         }                                                       |
| 94 -         transformed, err := p.applyRules(rec)                   |
| 95 -         if err != nil {                                         |
| 96 -             p.logger.Warn("skipping record", "id", rec.ID,      |
|      "error", err)                                                   |
| 97 -             p.metrics.IncrementSkipped()                        |
| 98 -             continue                                            |
| 99 -         }                                                       |
|100 -         if transformed.Score < p.threshold {                    |
|101 -             p.metrics.IncrementFiltered()                       |
|102 -             continue                                            |
|103 -         }                                                       |
|104 -         results = append(results, transformed)                  |
|105 -         p.metrics.IncrementProcessed()                          |
|106 -     }                                                           |
| 90 +     errCh := make(chan error, len(input))                       |
| 91 +     resultCh := make(chan Record, len(input))                   |
| 92 +                                                                 |
| 93 +     for _, rec := range input {                                 |
| 94 +         go func(r Record) {                                     |
| 95 +             if r.IsEmpty() {                                    |
| 96 +                 return                                          |
| 97 +             }                                                   |
| 98 +             transformed, err := p.applyRules(r)                 |
| 99 +             if err != nil {                                     |
|100 +                 p.logger.Warn("skipping record", "id", r.ID,    |
|      "error", err)                                                   |
|101 +                 p.metrics.IncrementSkipped()                    |
|102 +                 errCh <- err                                    |
